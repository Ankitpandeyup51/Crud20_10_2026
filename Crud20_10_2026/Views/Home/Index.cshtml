@model List<Crud20_10_2026.Models.Student>

@{
    ViewBag.Title = "Student List";
}

<h2>Student List</h2>

<p>
    @Html.ActionLink(
        "Add Student",
        "Create",
        "Student",
        null,
        new { @class = "btn btn-primary" }
    )
</p>

<table class="table table-bordered">

    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Email</th>
        <th>Course</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.Name</td>

            <td>@item.Email</td>

            <td>@item.Course</td>

            <td>

                @Html.ActionLink(
                    "Edit",
                    "Edit",
                    new { id = item.Id },
                    new { @class = "btn btn-warning" }
                )

                @Html.Raw(" ")

                @Html.ActionLink(
                    "Delete",
                    "Delete",
                    new { id = item.Id },
                    new
                    {
                        @class = "btn btn-danger",
                        onclick = "return confirm('Are you sure?');"
                    }
                )

            </td>

        </tr>
    }

</table>

