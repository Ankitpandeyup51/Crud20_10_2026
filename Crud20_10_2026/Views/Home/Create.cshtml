
@model Crud20_10_2026.Models.Student

@{
    ViewBag.Title = "Add Student";
}

<h2>Add Student</h2>

@using (Html.BeginForm())
{
    <div class="form-group">

        <label>Name</label>

        @Html.TextBoxFor(
            x => x.Name,
            new
            {
                @class = "form-control"
            }
        )

    </div>

    <br />

    <div class="form-group">

        <label>Email</label>

        @Html.TextBoxFor(
            x => x.Email,
            new
            {
                @class = "form-control"
            }
        )

    </div>

    <br />

    <div class="form-group">

        <label>Course</label>

        @Html.TextBoxFor(
            x => x.Course,
            new
            {
                @class = "form-control"
            }
        )

    </div>

    <br />

    <input type="submit"
           value="Save"
           class="btn btn-success" />

    @Html.ActionLink(
        "Back",
        "Index",
        null,
        new { @class = "btn btn-secondary" }
    )
}


